<resources>
    <string name="app_name">Look Up</string>
    <string name="tagline">Keeps an eye on the clock while you\'re on social media, and nudges you with a quote when it\'s time to look up. Only time is measured. Nothing you see or do inside an app is read, and nothing leaves your phone.</string>

    <string name="setup">Setup</string>
    <string name="step_usage">1. Usage access</string>
    <string name="step_usage_desc">Lets Look Up see which app is open, and for how long.</string>
    <string name="step_overlay">2. Display over other apps</string>
    <string name="step_overlay_desc">Lets the quote pop up on top of the social app.</string>
    <string name="step_notif">3. Notifications</string>
    <string name="step_notif_desc">Needed for the small \"Look Up is on\" notification.</string>
